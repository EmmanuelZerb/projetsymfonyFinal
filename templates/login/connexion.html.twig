{# login/formCon.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        /* Reset des styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f0f0f0;
        }

        .container {
            max-width: 400px;
            margin: 50px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        p {
            margin-bottom: 20px;
            font-size: 18px;
            color: #333;
        }

        form {
            margin-bottom: 20px;
        }

        .custom-form-control {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
            transition: border-color 0.3s;
        }

        .custom-form-control:focus {
            border-color: #007bff;
            outline: none;
        }

        button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            transition: background-color 0.3s;
        }

        button:hover {
            background-color: #0056b3;
        }

        .text-info {
            color: #007bff;
        }

        .error-message {
            color: #dc3545;
            font-size: 14px;
            margin-top: 5px;
        }
    </style>
{% endblock %}

{% block body %}

<div class="container">
    {# Message de bienvenue #}
    <p>Bienvenue sur le projet Symfony</p>

    {{ form_start(form) }}

    {# Couleur pour le label #}
    {{ form_label(form.login, 'Identifiant', {'label_attr': {'class': 'text-info'}}) }}
    {{ form_widget(form.login, {'attr': {'class': 'custom-form-control', 'placeholder': 'Identifiant'}}) }}

    {{ form_label(form.mdp, 'Mot de passe', {'label_attr': {'class': 'text-info'}}) }}
    {{ form_widget(form.mdp, {'attr': {'class': 'custom-form-control', 'placeholder': 'Mot de passe'}}) }}


    <button>Se connecter</button>

    {{ form_end(form) }}

    {# Afficher les messages flash d'erreur avec une couleur spécifique #}
    {% for flashMessage in app.flashes('error') %}
        <div class="error-message">
            {{ flashMessage }}
        </div>
    {% endfor %}
</div>

{% endblock %}
