{# login/formCon.html.twig #}

{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="custom-card">
                    <div class="custom-card-body">
                        {{ form_start(form) }}
                        
                        <div class="form-group">
                            {{ form_label(form.login, 'Identifiant', {'label_attr': {'class': 'text-center'}}) }}
                            {{ form_widget(form.login, {'attr': {'class': 'custom-form-control', 'placeholder': 'Identifiants'}}) }}
                        </div>
                        
                        <div class="form-group">
                            {{ form_label(form.mdp, 'Mot de passe', {'label_attr': {'class': 'text-center'}}) }}
                            {{ form_widget(form.mdp, {'attr': {'class': 'custom-form-control', 'placeholder': 'Mot de passe'}}) }}
                        </div>
                        
                        <button type="submit" class="custom-btn">Se connecter</button>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
         {# Afficher les messages flash d'erreur #}
        {% for flashMessage in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ flashMessage }}
            </div>
        {% endfor %}
    </div>
{% endblock %}