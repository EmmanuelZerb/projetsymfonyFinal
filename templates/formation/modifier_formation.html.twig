{% extends 'base.html.twig' %}

{% block body %}
    <style>
        /* CSS pour le formulaire de modification de formation */

        .container {
            margin-top: 50px;
            text-align: center;
        }

        h1 {
            font-size: 24px;
            margin-bottom: 20px;
            color: #333;
        }

        form {
            display: inline-block;
            text-align: left;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            font-size: 18px;
            color: #333;
        }

        input[type="text"], input[type="date"], select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ced4da;
            border-radius: 5px;
            font-size: 16px;
        }

        input[type="submit"] {
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        input[type="submit"]:hover {
            background-color: #0056b3;
        }
    </style>

    <div class="container">
        <h1>Modifier la Formation</h1>

        {{ form_start(form) }}
        <div class="form-group">
            {{ form_label(form.dateDebut) }}
            {{ form_widget(form.dateDebut) }}
        </div>
        <div class="form-group">
            {{ form_label(form.departement) }}
            {{ form_widget(form.departement) }}
        </div>
        <div class="form-group">
            {{ form_label(form.leproduit) }}
            {{ form_widget(form.leproduit) }}
        </div>
        <div class="form-group">
            {{ form_label(form.nombreHeures) }}
            {{ form_widget(form.nombreHeures) }}
        </div>
        
        <input type="submit" value="Enregistrer">
        {{ form_end(form) }}
    </div>
{% endblock %}
