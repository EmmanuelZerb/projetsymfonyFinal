

{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        /* CSS pour le formulaire de création de formation */

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1 {
            color: #6a0dad; /* Violet */
            text-align: center;
        }

        form {
            margin-top: 20px;
        }

        form input[type="text"],
        form select {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        form button[type="submit"] {
            background-color: #6a0dad; /* Violet */
            color: #fff;
            border: none;
            padding: 12px 20px;
            border-radius: 4px;
            cursor: pointer;
            display: block;
            width: 100%;
            font-size: 16px;
            margin-top: 20px;
        }

        form button[type="submit"]:hover {
            background-color: #4b078a; /* Darker violet for hover */
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <h1>Créer une Formation</h1>

        {{ form_start(form) }}
        {{ form_row(form.dateDebut) }}
        {{ form_row(form.departement) }}
        {{ form_row(form.leproduit) }}
        {{ form_row(form.nombreHeures) }}

        <button type="submit">Créer</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
