{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        /* Styles spécifiques pour la liste des formations */
        h1 {
            font-size: 24px;
            margin-bottom: 20px;
        }

        p {
            font-size: 16px;
            margin-bottom: 5px;
        }

        a {
            display: inline-block;
            padding: 5px 10px;
            background-color: #007bff;
            color: #fff;
            text-decoration: none;
            border-radius: 4px;
            transition: background-color 0.3s;
        }

        a:hover {
            background-color: #0056b3;
        }

        hr {
            margin-top: 10px;
            margin-bottom: 20px;
            border: none;
            border-top: 1px solid #ccc;
        }

        .disabled {
            pointer-events: none;
            background-color: #ccc !important;
            cursor: not-allowed;
        }
    </style>
{% endblock %}

{% block body %}

    <h1>Liste des Formations</h1>

    {% for formation in formations %}
        <p>{{formation.getNombreHeures() }}h - {{ formation.getLeproduit() }} - {{ formation.getDepartement() }} - {{ formation.getDateDebut()|date('Y-m-d') }}</p>
        <a href="#" onclick="handleInscription(this, '{{ path('employe_inscription', {'formationId': formation.getId()}) }}')" >S'inscrire</a>
        <hr>
    {% endfor %}

    <script>
        function handleInscription(button, url) {
            if (!button.classList.contains('disabled')) {
                button.innerHTML = 'Attendre confirmation d\'un administrateur';
                button.classList.add('disabled');
                event.preventDefault();
                var xhr = new XMLHttpRequest();
                xhr.open('GET', url, true);
                xhr.onload = function () {
                    if (xhr.status === 200) {
                        // La demande a réussi
                    } else {
                        // La demande a échoué
                    }
                };
                xhr.send();
            }
        }
    </script>
    
    <a href="{{ path('app_login') }}">Déconnexion</a>
    <a href="{{ path('status_Formation') }}">Status des formations</a>
    <a href="{{ path('status_Formation_En_Attente') }}">Formations En Attente</a>
    <a href="{{ path('status_Formation_accepte') }}">formations Accpetée</a>
    <a href="{{ path('status_Formation_refuse') }}">Formations Refusée</a>
    
{% endblock %}
