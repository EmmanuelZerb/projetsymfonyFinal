{% extends 'base.html.twig' %}

{% block title %}
    Recherche d'inscriptions
{% endblock %}

{% block body %}
    <div class="container">
        <h1>Recherche d'inscriptions</h1>

        <form action="{{ path('app_recherche_InscriptionEmploye') }}" method="get">
            <label for="nom">Nom:</label>
            <input type="text" id="nom" name="nom" required>
            <label for="prenom">Prénom:</label>
            <input type="text" id="prenom" name="prenom" required>
            <button type="submit">Rechercher</button>
        </form>

        {% if inscriptions is not empty %}
            <h2>Liste des inscriptions pour {{ nom }} {{ prenom }}</h2>
            <ul>
                {% for inscription in inscriptions %}
                    <li>{{ inscription.laformation.dateDebut|date('d/m/Y') }} - {{ inscription.laFormation.departement }}</li>
                    <!-- Ajoutez d'autres champs d'inscription si nécessaire -->
                {% endfor %}
            </ul>
        {% else %}
            {% if nom and prenom %}
                <p>Aucune inscription trouvée pour {{ nom }} {{ prenom }}.</p>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
